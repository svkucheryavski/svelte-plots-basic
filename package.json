{
   "name": "svelte-plots-basic",
   "description": "Svelte components for creating simple plots",
   "version": "4.0.0",
   "author": "Sergey Kucheryavskiy",
   "license": "MIT",
   "private": false,
   "type": "module",
   "scripts": {
      "check": "node scripts/check.cjs",
      "test": "node --test",
      "prepack": "npm run check && npm test"
   },
   "exports": {
      "./constants":  "./src/constants.js",
