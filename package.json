{
   "name": "svelte-plots-basic",
   "description": "Svelte components for creating simple plots",
   "version": "4.1.0",
   "author": "Sergey Kucheryavskiy",
   "license": "MIT",
   "private": false,
   "type": "module",
   "scripts": {
      "check": "node scripts/check.cjs",
      "test": "node --test",
      "prepack": "npm run check && npm test"
   },
   "exports": {
      "./constants":    { "svelte": "./src/constants.js",   "default": "./src/constants.js" },
      "./utils":        { "svelte": "./src/methods.js",     "default": "./src/methods.js" },
      "./2d":           { "svelte": "./src/2d/index.js",    "default": "./src/2d/index.js" },
      "./2d/*.svelte":  { "svelte": "./src/2d/*.svelte",    "default": "./src/2d/*.svelte" },
      "./3d":           { "svelte": "./src/3d/index.js",    "default": "./src/3d/index.js" },
      "./3d/*.svelte":  { "svelte": "./src/3d/*.svelte",    "default": "./src/3d/*.svelte" },
      "./package.json": "./package.json"
   },
   "devDependencies": {
      "mdatools": "^1.5.0",
      "svelte": "^5.56.8"
   },
   "peerDependencies": {
      "mdatools": "^1.5.0",
      "svelte": "^5.0.0"
   },
   "keywords": [
      "svelte",
      "plots",
      "charts",
      "svelte plots"
   ],
   "files": [
      "src",
      "NEWS.md"
   ],
   "repository": {
      "type": "git",
      "url": "svkucheryavski/svelte-plots-basic"
   }
}
